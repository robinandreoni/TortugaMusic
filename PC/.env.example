# ==============================================================
# Tortuga Music - Configurazione Variabili d'Ambiente
# ==============================================================

# Server Web Locale
PORT=5000
TORTUGA_HOST=0.0.0.0
TORTUGA_DEBUG=false
TORTUGA_SECRET_KEY=genera-una-chiave-segreta-random-qui

# ==============================================================
# Telegram Mirror Bot (Opzionale)
# ==============================================================
# 1. Vai su https://my.telegram.org e fai login con il tuo numero
# 2. Clicca su "API development tools"
# 3. Crea una nuova applicazione per ottenere API_ID e API_HASH
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_GROUP_LINK=

# ==============================================================
# GitHub Gist Sync (Opzionale - Per tunnel remoto e worker)
# ==============================================================
# Token GitHub con permessi 'gist'
GITHUB_TOKEN=
GIST_ID=
GITHUB_USERNAME=

# Worker URL Cloudflare (se configurato)
WORKER_URL=https://your-subdomain.workers.dev
